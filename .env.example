APP_NAME=Behavioral Monitoring System
APP_MODE=real
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DATABASE_URL=sqlite:///./data/behavioral_monitoring.db
FACE_CAMERA_SOURCE=http://adhd-camera.local:8090/stream/face
BODY_CAMERA_SOURCE=http://adhd-camera.local:8090/stream/body
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=20
FACE_CAMERA_WIDTH=640
FACE_CAMERA_HEIGHT=480
FACE_CAMERA_FPS=20
BODY_CAMERA_WIDTH=640
BODY_CAMERA_HEIGHT=480
BODY_CAMERA_FPS=20
FACE_PROCESS_FPS=15
BODY_PROCESS_FPS=10
CAMERA_RECONNECT_SECONDS=2.0
CAMERA_FAILURE_LIMIT=10
EAR_THRESHOLD=0.21
MIN_CLOSED_FRAMES=2
MAX_CLOSED_SECONDS=1.5
BLINK_REFRACTORY_SECONDS=0.15
BLINK_RATE_WINDOW_SECONDS=60
SHOW_FACE_LANDMARKS=true
HEAD_POSE_SMOOTHING_ALPHA=0.25
HEAD_MOVEMENT_THRESHOLD_DEGREES=12
HEAD_MOVEMENT_RELEASE_DEGREES=7
HEAD_MOVEMENT_REFRACTORY_SECONDS=0.75
HEAD_RATE_WINDOW_SECONDS=60
POSE_MODEL=models/yolo11n-pose.pt
POSE_CONFIDENCE=0.45
BODY_MOVEMENT_THRESHOLD=0.035
BODY_MOVEMENT_RELEASE=0.018
BODY_MOVEMENT_SMOOTHING_ALPHA=0.3
BODY_EVENT_REFRACTORY_SECONDS=0.75
POSTURE_CHANGE_THRESHOLD_DEGREES=12
KEYPOINT_CONFIDENCE=0.35
SHOW_BODY_SKELETON=true
LANDMARK_PROFILE=upper_body
FACE_DISPLAY_GROUPS=eyes,head_pose
FACE_MEASURE_GROUPS=eyes,head_pose
BODY_DISPLAY_GROUPS=head_shoulders,left_arm,right_arm,torso
BODY_MEASURE_GROUPS=head_shoulders,left_arm,right_arm,torso
FEATURE_TYPES=angle,frequency,normalized_movement
LOG_LEVEL=INFO
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3
SAVE_RAW_VIDEO=false
