# IPv6 listener also supports the .local link-local path used when router IPv4
# client isolation prevents laptop-to-Pi connections.
RPI_HOST=::
RPI_PORT=8090
RPI_FACE_CAMERA_SOURCE=0
RPI_BODY_CAMERA_SOURCE=1
RPI_CAMERA_WIDTH=360
RPI_CAMERA_HEIGHT=240
RPI_CAMERA_FPS=30
RPI_JPEG_QUALITY=75
RPI_RECONNECT_SECONDS=2
RPI_MOCK_MODE=false
